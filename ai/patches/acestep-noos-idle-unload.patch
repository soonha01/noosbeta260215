new file mode 100644
index 0000000..7f75781
--- /dev/null
+++ b/acestep/api/model_unload_runtime.py
@@ -0,0 +1,226 @@
+"""ACE-Step model unload and idle-release helpers for the API runtime."""
+
+from __future__ import annotations
+
+import asyncio
+import gc
+import os
+from typing import Any
+
+
+def ace_step_idle_unload_seconds() -> int:
+    """Return idle-unload delay in seconds; 0 disables automatic unload."""
+
+    raw_value = os.getenv("ACESTEP_IDLE_UNLOAD_SEC", "300").strip()
+    try:
+        return max(0, int(raw_value))
+    except ValueError:
+        return 300
+
+
+def _queue_size(app_state: Any) -> int:
+    queue_ref = getattr(app_state, "job_queue", None)
+    if queue_ref is None or not hasattr(queue_ref, "qsize"):
+        return 0
+    try:
+        return int(queue_ref.qsize())
+    except Exception:
+        return 0
+
+
+def _active_job_count(app_state: Any) -> int:
+    try:
+        return max(0, int(getattr(app_state, "_active_generation_jobs", 0)))
+    except Exception:
+        return 0
+
+
+def _is_busy(app_state: Any) -> bool:
+    return _active_job_count(app_state) > 0 or _queue_size(app_state) > 0
+
+
+def _clear_accelerator_cache() -> None:
+    gc.collect()
+    try:
+        import torch
+
+        if torch.cuda.is_available():
+            torch.cuda.empty_cache()
+            torch.cuda.synchronize()
+        elif hasattr(torch, "mps") and hasattr(torch.backends, "mps") and torch.backends.mps.is_available():
+            if hasattr(torch.mps, "empty_cache"):
+                torch.mps.empty_cache()
+            if hasattr(torch.mps, "synchronize"):
+                torch.mps.synchronize()
+        elif hasattr(torch, "xpu") and torch.xpu.is_available():
+            torch.xpu.empty_cache()
+            torch.xpu.synchronize()
+    except Exception:
+        pass
+
+
+def _unload_handler(handler: Any) -> bool:
+    if handler is None:
+        return False
+
+    had_model = any(
+        getattr(handler, attr, None) is not None
+        for attr in (
+            "model",
+            "vae",
+            "text_encoder",
+            "text_tokenizer",
+            "silence_latent",
+            "reward_model",
+            "mlx_decoder",
+            "mlx_vae",
+        )
+    )
+
+    for attr in (
+        "model",
+        "config",
+        "vae",
+        "text_encoder",
+        "text_tokenizer",
+        "silence_latent",
+        "reward_model",
+        "last_init_params",
+        "quantization",
+        "_base_decoder",
+        "mlx_decoder",
+        "mlx_vae",
+    ):
+        if hasattr(handler, attr):
+            setattr(handler, attr, None)
+
+    for attr in ("lora_loaded", "use_lora", "use_mlx_dit", "mlx_dit_compiled", "use_mlx_vae", "compiled"):
+        if hasattr(handler, attr):
+            setattr(handler, attr, False)
+
+    if hasattr(handler, "lora_scale"):
+        handler.lora_scale = 1.0
+    if hasattr(handler, "_active_loras"):
+        handler._active_loras = {}
+    if hasattr(handler, "_lora_adapter_registry"):
+        handler._lora_adapter_registry = {}
+    if hasattr(handler, "_lora_active_adapter"):
+        handler._lora_active_adapter = None
+
+    try:
+        if hasattr(handler, "_empty_cache"):
+            handler._empty_cache()
+    except Exception:
+        pass
+
+    return had_model
+
+
+def unload_ace_step_models(app_state: Any, *, force: bool = False) -> dict[str, Any]:
+    """Unload DiT/LM weights while keeping the API process alive."""
+
+    if not force and _is_busy(app_state):
+        return {
+            "unloaded": False,
+            "reason": "busy",
+            "active_jobs": _active_job_count(app_state),
+            "queue_size": _queue_size(app_state),
+        }
+
+    slots: list[int] = []
+    for slot, handler_attr, init_attr, error_attr in (
+        (1, "handler", "_initialized", "_init_error"),
+        (2, "handler2", "_initialized2", "_init_error2"),
+        (3, "handler3", "_initialized3", "_init_error3"),
+    ):
+        handler = getattr(app_state, handler_attr, None)
+        if handler is None:
+            continue
+        if _unload_handler(handler) or bool(getattr(app_state, init_attr, False)):
+            slots.append(slot)
+        setattr(app_state, init_attr, False)
+        setattr(app_state, error_attr, None)
+
+    llm_unloaded = False
+    llm_handler = getattr(app_state, "llm_handler", None)
+    if llm_handler is not None:
+        llm_unloaded = bool(getattr(llm_handler, "llm_initialized", False) or getattr(app_state, "_llm_initialized", False))
+        unload_fn = getattr(llm_handler, "unload", None)
+        if callable(unload_fn):
+            unload_fn()
+    app_state._llm_initialized = False
+    app_state._llm_init_error = None
+    app_state._llm_lazy_load_disabled = False
+
+    _clear_accelerator_cache()
+    return {
+        "unloaded": bool(slots or llm_unloaded),
+        "slots": slots,
+        "llm_unloaded": llm_unloaded,
+        "active_jobs": _active_job_count(app_state),
+        "queue_size": _queue_size(app_state),
+    }
+
+
+async def cancel_ace_step_idle_unload(app_state: Any) -> None:
+    task = getattr(app_state, "_ace_idle_unload_task", None)
+    if task is None or task.done():
+        app_state._ace_idle_unload_task = None
+        return
+    task.cancel()
+    try:
+        await task
+    except asyncio.CancelledError:
+        pass
+    finally:
+        app_state._ace_idle_unload_task = None
+
+
+async def _ensure_active_job_lock(app_state: Any) -> asyncio.Lock:
+    lock = getattr(app_state, "_active_generation_jobs_lock", None)
+    if lock is None:
+        lock = asyncio.Lock()
+        app_state._active_generation_jobs_lock = lock
+    return lock
+
+
+async def mark_ace_step_job_started(app_state: Any) -> None:
+    await cancel_ace_step_idle_unload(app_state)
+    lock = await _ensure_active_job_lock(app_state)
+    async with lock:
+        app_state._active_generation_jobs = _active_job_count(app_state) + 1
+
+
+async def mark_ace_step_job_finished(app_state: Any) -> None:
+    lock = await _ensure_active_job_lock(app_state)
+    async with lock:
+        app_state._active_generation_jobs = max(0, _active_job_count(app_state) - 1)
+    await schedule_ace_step_idle_unload(app_state)
+
+
+async def schedule_ace_step_idle_unload(app_state: Any) -> None:
+    delay_seconds = ace_step_idle_unload_seconds()
+    if delay_seconds <= 0 or _is_busy(app_state):
+        return
+
+    await cancel_ace_step_idle_unload(app_state)
+
+    async def _idle_unload() -> None:
+        try:
+            await asyncio.sleep(delay_seconds)
+            if _is_busy(app_state):
+                return
+            async with app_state._init_lock:
+                if _is_busy(app_state):
+                    return
+                loop = asyncio.get_running_loop()
+                await loop.run_in_executor(app_state.executor, lambda: unload_ace_step_models(app_state))
+        except asyncio.CancelledError:
+            raise
+        except Exception as exc:
+            print(f"[API Server] ACE-Step idle unload failed: {exc}")
+        finally:
+            if getattr(app_state, "_ace_idle_unload_task", None) is asyncio.current_task():
+                app_state._ace_idle_unload_task = None
+
+    app_state._ace_idle_unload_task = asyncio.create_task(_idle_unload())
