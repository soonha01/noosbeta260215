<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.noos.backend.auth.mapper.AuthMapper">

    <insert id="signup">

        INSERT INTO users
        (
            login_id,
            password_hash,
            display_name,
            created_at
        )
        VALUES
            (
                #{loginId},
                #{password},
                #{displayName},
                NOW()
            )

    </insert>

</mapper>